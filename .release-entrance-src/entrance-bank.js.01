 }else if(unit==='simultaneous'){
  if(form===0){const bikes=r(6,16),carts=r(4,14),total=bikes+carts,wheels=2*bikes+4*carts;out(`A shed contains ${total} vehicles: bicycles with 2 wheels and carts with 4 wheels. There are ${wheels} wheels altogether. How many carts are there?`,carts,[`An all-bicycle baseline gives ${total} × 2 = ${total*2} wheels.`,`Extra wheels = ${wheels} − ${total*2} = ${2*carts}.`,`Each cart adds 2 beyond the baseline, giving ${carts} carts.`],{total,wheels});}
  if(form===1){const a=r(4,12),b=r(2,8),one=2*a+3*b,two=4*a+b;out(`Two notebooks and three pens cost $${one}. Four notebooks and one pen cost $${two}. What is the price of one notebook?`,a,[`Let notebook and pen prices be n and p.`,`2n + 3p = ${one}; 4n + p = ${two}.`,`Multiply the second equation by 3 and subtract the first: 10n = ${3*two-one}.`,`n = $${a}; the pen price is $${b}.`],{one,two},{prefix:'$'});}
  if(form===2){const years=r(2,5),young=3*years;out(`${years} years ago, an adult was 5 times a child’s age. In ${years} years, the adult will be 3 times the child’s age. How old is the child now?`,young,[`Let the child’s present age be c and the adult’s be a.`,`a − ${years} = 5(c − ${years}), so a = 5c − ${4*years}.`,`a + ${years} = 3(c + ${years}), so a = 3c + ${2*years}.`,`2c = ${6*years}; c = ${young} years.`],{years},{suffix:'years'});}
  if(form===3){const a=r(5,14),b=r(2,7),one=3*a+2*b,two=2*a+5*b;out(`Three panels and two brackets cost $${one}. Two panels and five brackets cost $${two}. What is the cost of four panels and three brackets?`,4*a+3*b,[`Let prices be p and b: 3p + 2b = ${one}; 2p + 5b = ${two}.`,`Multiply the first by 5 and the second by 2, then subtract: 11p = ${5*one-2*two}.`,`One panel costs $${a} and one bracket costs $${b}.`,`Required cost = 4 × ${a} + 3 × ${b} = $${4*a+3*b}.`],{one,two},{prefix:'$'});}
 }else if(unit==='ratios'){
  if(form===0){const a=r(2,5),b=a+r(1,4),k=r(3,9);out(`The ratio of blue beads to white beads is ${a}:${b}. There are ${b*k} white beads. How many beads are there altogether?`,(a+b)*k,[`${b} units = ${b*k}, so 1 unit = ${k}.`,`The total has ${a+b} units.`,`Total = ${a+b} × ${k} = ${(a+b)*k}.`],{a,b,white:b*k});}
  if(form===1){const k=r(4,18);out(`The ratio of red to blue tiles is 2:3. After ${7*k} blue tiles are added, it is 3:8. No red tiles are changed. How many tiles were there at first?`,15*k,[`Match the unchanged red amount: 2:3 becomes 6:9; 3:8 becomes 6:16.`,`The extra ${7*k} blue tiles represent 7 units.`,`One unit = ${k}; original total = 15 × ${k} = ${15*k}.`],{added:7*k});}
  if(form===2){const k=r(5,21);out(`Counters in boxes A and B are in the ratio 5:3. Moving ${k} counters from A to B makes the two amounts equal. How many counters are there altogether?`,8*k,[`The original difference is 2 ratio units.`,`Moving counters changes the difference by twice the number moved: one leaves A and joins B.`,`So 1 unit = ${k}; total = 8 × ${k} = ${8*k}.`],{moved:k});}
  if(form===3){const k=r(2,8),a=10*k,b=15*k;out(`A supply of water can give ${a} litres to each can in group A, or ${b} litres to each can in group B. The groups have no cans in common. If the same water is shared equally among all cans in both groups, how many litres does each can receive?`,6*k,[`Choose a convenient supply of ${a*b} litres.`,`It serves ${b} cans in A or ${a} cans in B.`,`Together there are ${a+b} cans.`,`Equal share = ${a*b} ÷ ${a+b} = ${6*k} litres. The chosen supply cancels out.`],{a,b},{suffix:'litres'});}
 }else if(unit==='rates'){
  if(form===0){const rate=r(6,18),time=r(4,10),target=rate*r(12,25);out(`A machine produces ${rate*time} identical parts in ${time} minutes at a constant rate. How many minutes does it need for ${target} parts?`,target/rate,[`Rate = ${rate*time} ÷ ${time} = ${rate} parts per minute.`,`Time = ${target} ÷ ${rate} = ${target/rate} minutes.`],{count:rate*time,time,target},{suffix:'minutes'});}
  if(form===1){const k=r(2,7),a=3*k,b=6*k;out(`Pump A fills a tank in ${a} hours; pump B fills it in ${b} hours. Both have constant rates and can operate independently. Starting together with an empty tank, how many hours do they take to fill it?`,2*k,[`A fills 1/${a} tank per hour; B fills 1/${b}.`,`Combined rate = ${fraction(a+b,a*b)} tank per hour.`,`Time for one tank = ${2*k} hours.`],{a,b},{suffix:'hours'});}
  if(form===2){const combined=r(15,30),a=r(5,12),time=r(3,8),b=combined-a,target=b*r(10,20);out(`Two workers together pack ${combined*time} parcels in ${time} hours. The first alone packs ${a*4} parcels in 4 hours. At these constant rates, how many hours would the second alone need to pack ${target} parcels?`,target/b,[`Combined rate = ${combined*time} ÷ ${time} = ${combined} parcels/hour.`,`First worker’s rate = ${a*4} ÷ 4 = ${a}.`,`Second worker’s rate = ${combined} − ${a} = ${b}.`,`Required time = ${target} ÷ ${b} = ${target/b} hours.`],{count:combined*time,time,first:a*4,target},{suffix:'hours'});}
  if(form===3){const inflow=r(2,5),rate=r(8,15),stock=(rate-inflow)*r(10,20),outflow=2*rate,first=stock/(rate-inflow);out(`Water flows into a tank at a constant rate of ${inflow} litres per minute. One pump removes ${rate} litres per minute and empties the initially partly filled tank in ${first} minutes while the inflow continues. How many minutes would two identical pumps take from the same starting amount, with the inflow still continuing?`,stock/(outflow-inflow),[`With one pump, net removal = ${rate} − ${inflow} = ${rate-inflow} litres/minute.`,`Starting amount = ${first} × ${rate-inflow} = ${stock} litres.`,`With two pumps, net removal = ${outflow} − ${inflow} = ${outflow-inflow}.`,`Time = ${stock}/${outflow-inflow} minutes. Leave as an exact fraction if needed.`],{inflow,rate,first},{suffix:'minutes',answerLabel:fraction(stock,outflow-inflow)});}
 }else if(unit==='motion'){
  if(form===0){const a=r(40,70),b=r(30,50),t=r(4,9),distance=(a+b)*t;out(`Two walkers start ${distance} m apart and walk towards each other along a straight path at ${a} m/min and ${b} m/min. After how many minutes do they meet?`,t,[`The gap closes at ${a} + ${b} = ${a+b} m/min.`,`Time = ${distance} ÷ ${a+b} = ${t} minutes.`],{a,b,distance},{suffix:'minutes',figure:{kind:'motion',a,b,distance,alt:`Two walkers ${distance} m apart, moving towards each other at ${a} and ${b} metres per minute.`}});}
  if(form===1){const a=r(6,10)*10,b=a-r(2,4)*10,leg=lcm(a,b);out(`A rider travels ${leg} km at ${a} km/h, then returns along the same route at ${b} km/h without stopping. What is the average speed for the whole journey? Give an exact fraction if needed.`,2*a*b/(a+b),[`Outward time = ${leg}/${a} = ${leg/a} hours.`,`Return time = ${leg}/${b} = ${leg/b} hours.`,`Average speed = total distance / total time = ${2*leg}/${leg/a+leg/b} = ${fraction(2*a*b,a+b)} km/h.`,`The two times differ, so do not average the speeds directly.`],{a,b,leg},{suffix:'km/h',answerLabel:fraction(2*a*b,a+b)});}
  if(form===2){const a=r(4,8),b=r(3,7),distance=(a+b)*r(2,5),messenger=r(15,25);out(`Two walkers approach each other along a straight road at ${a} km/h and ${b} km/h from points ${distance} km apart. A drone flies back and forth between them at a constant ${messenger} km/h until they meet, turning without delay. How far does the drone travel?`,distance/(a+b)*messenger,[`Meeting time = ${distance} ÷ (${a} + ${b}) = ${distance/(a+b)} hours.`,`The drone flies for that entire time.`,`Distance = ${messenger} × ${distance/(a+b)} = ${distance/(a+b)*messenger} km.`],{a,b,distance,messenger},{suffix:'km'});}
  if(form===3){const walk=r(2,5),belt=r(1,walk-1),length=lcm(walk+belt,walk-belt)*r(3,7),withTime=length/(walk+belt),againstTime=length/(walk-belt);out(`A moving walkway has a constant speed. A child walks at the same speed relative to it in either direction. Crossing with the walkway takes ${withTime} seconds; crossing against it takes ${againstTime} seconds. The child’s walking speed relative to the walkway is ${walk} m/s. How long is the walkway?`,length,[`Let its length be L and its speed be v.`,`L/${withTime} = ${walk} + v; L/${againstTime} = ${walk} − v.`,`Add to eliminate v: L(1/${withTime} + 1/${againstTime}) = ${2*walk}.`,`L = ${length} metres.`],{walk,withTime,againstTime},{suffix:'m'});}
 }else if(unit==='capacity'){
  const large=3*r(4,9),small=large*2,usedLarge=r(2,5),usedSmall=r(5,12),capacity=lcm(large,small);
  if(form===0)out(`A rack holds ${large} large trays or ${small} small trays. How many small trays occupy the same space as ${usedLarge} large trays?`,2*usedLarge,[`One large tray occupies the same space as ${small}/${large} = 2 small trays.`,`${usedLarge} large trays correspond to ${2*usedLarge} small trays.`],{large,small,usedLarge});
  if(form===1)out(`A rack holds ${large} large trays or ${small} small trays. It currently contains ${usedLarge} large trays and ${usedSmall} small trays. What is the greatest number of additional large trays that will fit?`,Math.floor((small-2*usedLarge-usedSmall)/2),[`Use small-tray units: capacity ${small}; each large tray uses 2.`,`Unused capacity = ${small} − ${usedLarge} × 2 − ${usedSmall} = ${small-2*usedLarge-usedSmall}.`,`Divide by 2 and take complete trays only: ${Math.floor((small-2*usedLarge-usedSmall)/2)}.`],{large,small,usedLarge,usedSmall});
  if(form===2){const a=5*r(3,7),b=3*a/5,taken=r(2,5),fill=a-taken;out(`A container holds ${a} small boxes or ${b} large boxes. It is full of small boxes. What is the minimum number of small boxes that must be removed to make room for ${taken} large boxes?`,Math.ceil(taken*a/b),[`One large box uses ${a}/${b} small-box spaces.`,`${taken} large boxes need ${fraction(taken*a,b)} small-box spaces.`,`Remove at least that many complete small boxes: ${Math.ceil(taken*a/b)}.`],{a,b,taken});}
  if(form===3){const capacity=60*r(2,5),wide=5,narrow=3,count=r(4,9),remain=capacity-wide*count;out(`A shelf is ${capacity} cm long. Wide books are 5 cm thick and narrow books are 3 cm thick. There must be ${count} wide books and at least one narrow book. What is the greatest total number of books that can fit in one row?`,count+Math.floor(remain/narrow),[`The required wide books use ${count} × 5 = ${5*count} cm.`,`The remaining ${remain} cm fit ${Math.floor(remain/3)} complete narrow books.`,`Total = ${count} + ${Math.floor(remain/3)} = ${count+Math.floor(remain/3)}.`],{capacity,count});}
 }else if(unit==='area'){
