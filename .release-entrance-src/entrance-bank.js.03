 }else if(unit==='spirals'){
  const N=form===0?r(27,60):r(220,750),p=F.spiral(N-1);let pairs=0;while((pairs+1)*(pairs+2)<=N-1)pairs++;const used=pairs*(pairs+1),start=(pairs%2?1:-1)*Math.ceil(pairs/2),remaining=N-1-used;
  const spiralSteps=[`Number ${N} requires ${N-1} moves because 1 is already at the centre.`,`Group lengths into pairs: (1,1), (2,2), … . The first ${pairs} complete pairs use ${pairs} × ${pairs+1} = ${used} moves.`,`At the end of those pairs the point is (${start}, ${start}). A complete pair of odd length moves right then up; one of even length moves left then down.`,`There are ${remaining} moves left. The next directions are ${pairs%2?'left then down':'right then up'}, with at most ${pairs+1} moves on each segment.`,`The resulting point is (${p.x}, ${p.y}); choose only the coordinate asked for.`];
  if(form===0||form===2)out(`Numbers begin with 1 at the centre of a square spiral. From 1, move right 1 step, up 1, left 2, down 2, right 3, up 3, and continue the pattern. What is the horizontal coordinate of ${N}, taking the centre as 0 and right as positive?`,p.x,spiralSteps,{N},{figure:{kind:'spiral',alt:'First 25 values of a counterclockwise square spiral beginning by moving right. Larger requested values are outside the displayed sample.'}});
  if(form===1){const length=r(50,250),p=F.spiral(length),last=p.segments.at(-1);out(`A pen draws a square spiral with segment lengths 1, 1, 2, 2, 3, 3, … cm, turning left after each segment. It stops after drawing exactly ${length} cm. How much of its final segment has it drawn? Count the final segment even when it is complete.`,last.length,[`Add complete lengths in the order 1,1,2,2,… .`,`Before the final segment, ${length-last.length} cm has been drawn.`,`The final drawn portion is ${length} − ${length-last.length} = ${last.length} cm.`],{length},{suffix:'cm',figure:{kind:'spiralPath',alt:'A line turns left after segments of lengths 1,1,2,2,3,3 and so on. Only an initial sample is drawn, not the final requested length.'}});}
  if(form===3)out(`A square spiral begins with 1 at the centre and moves right, up, left, down with successive step counts 1, 1, 2, 2, 3, 3, … . What is the vertical coordinate of number ${N}, using 0 at the centre and up as positive?`,p.y,spiralSteps,{N},{figure:{kind:'spiral'}});
 }else if(unit==='cases'){
  if(form===0||form===1){const labels=['A','B','C'],rotation=r(0,2),a=labels[rotation],b=labels[(rotation+1)%3],c=labels[(rotation+2)%3];out(`A token is in exactly one of boxes A, B or C. The labels read: ${a}: “The token is in ${b}.” ${b}: “The token is not in ${b}.” ${c}: “The token is not in ${c}.” Exactly one label is true. Which box contains the token?`,c,[`The first two statements are opposites, so exactly one of them is always true.`,`The third statement must therefore be false.`,`So the token is in ${c}. Check that only one label is true in that case.`],{a,b,c},{choices:['A','B','C']});}
  if(form===2){const a=r(5,9),b=r(1,4),total=11*(a+b),difference=a-b;out(`A and B are different non-zero digits. The two-digit numbers AB and BA have sum ${total}. A is ${difference} greater than B. Find AB.`,10*a+b,[`AB + BA = 11(A+B), so A+B = ${total/11}.`,`Also A−B = ${difference}.`,`Solve: A = ${a}, B = ${b}.`,`AB = ${10*a+b}; check the column addition and both non-zero digits.`],{total,difference});}
  if(form===3){const n=r(25,60),a=r(2,5),b=r(6,10),total=a*n+b*(n+1);out(`A positive whole number x satisfies both conditions: ${a}x + ${b}y = ${total}, and y = x + 1. What is the value of x + y?`,2*n+1,[`Substitute y = x+1 into the first condition.`,`${a+b}x + ${b} = ${total}, so x = ${n}.`,`Then y = ${n+1}; x+y = ${2*n+1}.`,`Both positive-integer conditions are satisfied.`],{a,b,total});}
 }else if(unit==='invariants'){
  if(form===0){const start=2*r(3,12),target=start+2*r(3,10)+1;out(`Start with ${start}. A move may add 6 or subtract 4; negative intermediate values are allowed. Is it possible to reach ${target}?`, 'No',[`The start ${start} is even.`,`Both allowed changes are even, so every reachable number is even.`,`${target} is odd, so it cannot be reached.`],{start,target},{choices:['Yes','No']});}
  if(form===1){const N=r(8,22)**2+r(0,9);out(`${N} switches are initially off and numbered 1 to ${N}. On pass k, every switch whose number is a multiple of k is flipped, for k = 1 to ${N}. How many switches are on at the end?`,Math.floor(Math.sqrt(N)),['Switch n is flipped once for each positive factor of n.','Only perfect squares have an odd number of positive factors. ',`Count the squares at most ${N}: there are ${Math.floor(Math.sqrt(N))}.`],{N});}
  if(form===2){const colours=r(3,8),need=r(3,6);out(`A bag has many beads of each of ${colours} colours, at least ${need} of every colour. What is the smallest number of beads that must be drawn without looking to guarantee ${need} of the same colour?`,colours*(need-1)+1,[`In the worst case, draw ${need-1} of every colour without reaching ${need}.`,`That is ${colours*(need-1)} beads.`,`One more guarantees ${need} of one colour, so ${colours*(need-1)+1} are required.`],{colours,need});}
  if(form===3){const n=2*r(6,15);out(`Cards are numbered 1 to ${n}, once each. What is the smallest number of cards that must be selected to guarantee that two selected numbers have sum ${n+1}?`,n/2+1,[`Pair 1 with ${n}, 2 with ${n-1}, and so on. There are ${n/2} disjoint pairs.`,`It is possible to take one from every pair and avoid the required sum.`,`Taking ${n/2+1} forces one complete pair.`],{n});}
 }else if(unit==='bounds'){
  if(form===0||form===2){const budget=r(22,45),costs=form===0?[4,7]:[4,7,11],counts=form===0?[5,9]:[5,9,15],best=bestPacks(budget,costs,counts);out(`Puzzle tokens are sold only in complete packs. ${counts.map((n,i)=>`A pack of ${n} costs $${costs[i]}`).join('; ')}. With $${budget}, what is the greatest number of tokens that can be bought?`,best.best,[`Enumerate each possible count of the largest pack from 0 to ${Math.floor(budget/costs.at(-1))}.`,`For each remaining budget, compare complete smaller packs.`,`The best combination is ${best.winner.map((n,i)=>`${n} pack(s) of ${counts[i]}`).join(', ')}.`,`It gives ${best.best} tokens and costs $${best.winner.reduce((s,n,i)=>s+n*costs[i],0)}. The enumeration covers all affordable cases.`],{budget,costs,counts});}
  if(form===1){const total=r(30,50),a=total-r(5,12),b=total-r(8,15);out(`In a group of ${total} pupils, ${a} play chess and ${b} play badminton. What is the smallest possible number who play both?`,a+b-total,[`The two counts add to ${a+b}, exceeding the population by ${a+b-total}.`,`At least ${a+b-total} must be counted in both groups.`,`This is attainable by having everyone in at least one group, so it is the minimum.`],{total,a,b});}
  if(form===3){const a=r(15,30),b=r(12,25),both=r(5,10),total=a+b-both+r(2,20);out(`Of ${total} pupils, ${a} join robotics, ${b} join music, and ${both} join both. How many join neither club?`,total-a-b+both,[`Count the union once: ${a} + ${b} − ${both} = ${a+b-both}.`,`Neither = total − union = ${total} − ${a+b-both} = ${total-a-b+both}.`],{total,a,b,both});}
 }
 if(!q)throw Error('Unimplemented template');
 q.answerLabel??=typeof q.answer==='object'?`${q.answer.a}+${q.answer.b}π`:String(round(Number(q.answer))===Number(q.answer)?q.answer:q.answer);
 q.fingerprint=hash(q.text+'|'+JSON.stringify(q.figure||{}));return q;
}
// Restricted arithmetic parser, never eval. A pair [a,b] represents a + bπ.
function parse(input,suffix=''){
 let s=String(input).trim().toLowerCase().replace(/−|–/g,'-').replace(/×/g,'*').replace(/÷/g,'/').replace(/π/g,'pi').replace(/,/g,'').replace(/^\$\s*/,'');
 const units={cm:['cm','centimetres','centimeters'],m:['m','metres','meters'],'cm²':['cm²','cm2','square centimetres'],'m²':['m²','m2','square metres'],hours:['hours','hour','h'],minutes:['minutes','minute','min'],seconds:['seconds','second','s'],years:['years','year'],litres:['litres','liters','l'],'km/h':['km/h'],km:['km'],'°':['°','degrees','deg']};
 for(const u of units[suffix]||[]){if(s.endsWith(u)){s=s.slice(0,-u.length).trim();break;}}
 s=s.replace(/(-?\d+)\s+(\d+)\s*\/\s*(\d+)/g,(_,a,b,c)=>a[0]==='-'?`(-(${a.slice(1)}+${b}/${c}))`:`(${a}+${b}/${c})`).replace(/\s+/g,'').replace(/(\d|\))(?=pi|\()/g,'$1*').replace(/pi(?=\d|\()/g,'pi*');
 if(!s||s.length>180)return null;const tokens=s.match(/pi|(?:\d+(?:\.\d*)?|\.\d+)|[()+*/-]/g)||[];if(tokens.join('')!==s||tokens.length>100)return null;let i=0;
 const sum=(a,b,sign)=>[a[0]+sign*b[0],a[1]+sign*b[1]];
 function factor(){const t=tokens[i++];if(t==='+')return factor();if(t==='-'){const x=factor();return x.map(n=>-n);}if(t==='('){const x=expr();if(tokens[i++]!==')')throw Error();return x;}if(t==='pi')return [0,1];if(t!==undefined&&Number.isFinite(Number(t)))return [Number(t),0];throw Error();}
 function term(){let a=factor();while(tokens[i]==='*'||tokens[i]==='/'){const op=tokens[i++],b=factor();if(op==='*'){if(a[1]&&b[1])throw Error();a=[a[0]*b[0],a[0]*b[1]+a[1]*b[0]];}else{if(b[1]||!b[0])throw Error();a=a.map(x=>x/b[0]);}}return a;}
 function expr(){let a=term();while(tokens[i]==='+'||tokens[i]==='-'){const sign=tokens[i++]==='+'?1:-1;a=sum(a,term(),sign);}return a;}
 try{const a=expr();return i===tokens.length&&a.every(Number.isFinite)?a.map(n=>n===0?0:n):null;}catch(_){return null;}
}
function mark(q,input){if(typeof q.answer==='string')return String(input).trim().toLowerCase()===q.answer.toLowerCase();const a=parse(input,q.suffix),b=typeof q.answer==='object'?[q.answer.a,q.answer.b]:[q.answer,0];return !!a&&a.every((x,i)=>Math.abs(x-b[i])<=1e-9*Math.max(1,Math.abs(b[i])));}
root.MochiEntranceBank={make,mark,parse,hash,fraction,modPow,exposed,bestPacks};if(typeof module!=='undefined')module.exports=root.MochiEntranceBank;
})(typeof globalThis!=='undefined'?globalThis:this);
