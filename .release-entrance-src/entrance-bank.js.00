/* Seeded original questions. Forms 0/1/2 are guided/application/transfer.
   Form 3 is reserved for independent papers and never selected by practice. */
(function(root){
'use strict';
const D=root.MochiEntranceData||(typeof require==='function'?require('./entrance-data.js'):null);
const F=root.MochiEntranceFigures||(typeof require==='function'?require('./entrance-figures.js'):null);
const gcd=(a,b)=>b?gcd(b,a%b):Math.abs(a),lcm=(a,b)=>a/gcd(a,b)*b,round=x=>Math.round(x*1e8)/1e8;
const fraction=(a,b)=>{const g=gcd(a,b);return b/g===1?String(a/g):`${a/g}/${b/g}`;};
function random(seed){let n=seed>>>0;return (a,b)=>{n=(Math.imul(1664525,n)+1013904223)>>>0;return a+Math.floor(n/4294967296*(b-a+1));};}
function hash(s){let h=2166136261;for(const c of s){h=Math.imul(h^c.charCodeAt(0),16777619);}return (h>>>0).toString(36);}
function modPow(b,n,m){let v=1;while(n-- >0)v=v*b%m;return v;}
function exposed(edge,hole=0){const c=new Set();for(let x=0;x<edge;x++)for(let y=0;y<edge;y++)for(let z=0;z<edge;z++)if(!(hole&&x>=1&&x<=hole&&y>=1&&y<=hole))c.add([x,y,z].join(','));let faces=0;for(const key of c){const p=key.split(',').map(Number);for(const [d,k]of [[0,-1],[0,1],[1,-1],[1,1],[2,-1],[2,1]]){const q=p.slice();q[d]+=k;if(!c.has(q.join(',')))faces++;}}return faces;}
function bestPacks(budget,costs,counts){let best=0,winner=[];function visit(i,remaining,total,chosen){if(i===costs.length){if(total>best){best=total;winner=chosen;}return;}for(let n=0;n<=Math.floor(remaining/costs[i]);n++)visit(i+1,remaining-n*costs[i],total+n*counts[i],[...chosen,n]);}visit(0,budget,0,[]);return {best,winner};}
function make(unit,form,seed){
 const u=D.units.find(x=>x.id===unit);if(!u||!Number.isInteger(form)||form<0||form>3||!Number.isSafeInteger(seed)||seed<0||seed>4294967295)throw Error('Invalid question identity');
 const r=random((seed^parseInt(hash(unit),36)^Math.imul(form+1,2654435761))>>>0),pick=a=>a[r(0,a.length-1)];let q;
 const out=(text,answer,steps,params={},extra={})=>q={unit,strand:u.strand,form,seed,id:`ep1:${unit}:${form}:${seed}`,text,answer,steps,params,level:form===0?1:form===1?2:3,...extra};
 if(unit==='relationships'){
  if(form===0){const x=r(3,14),a=r(3,8),b=r(4,20);out(`A number is multiplied by ${a}, then ${b} is added. The result is ${a*x+b}. What is the number?`,x,[`Let the number be x: ${a}x + ${b} = ${a*x+b}.`,`Subtract ${b}, then divide by ${a}: x = ${x}.`,`Check: ${a} × ${x} + ${b} = ${a*x+b}.`],{x,a,b});}
  if(form===1){const small=r(13,45),difference=r(7,21),total=2*small+difference;out(`Two trays contain ${total} counters altogether. The first tray contains ${difference} more than the second. How many counters are in the second tray?`,small,[`Remove the difference: ${total} − ${difference} = ${2*small}.`,`This is twice the smaller amount: ${2*small} ÷ 2 = ${small}.`,`The other tray has ${small+difference}; together they have ${total}.`],{total,difference});}
  if(form===2){const excess=2*r(2,9),short=2*r(2,7),depth=(excess+3*short)/2;out(`A cord is ${excess} cm longer than the depth of a container. Folded into three equal lengths, it is ${short} cm shorter than that depth. What is the depth of the container?`,depth,[`Let the depth be d. The cord is d + ${excess} cm.`,`Three folded lengths give 3(d − ${short}) = d + ${excess}.`,`Thus 2d = ${excess+3*short}, so d = ${depth} cm.`,`Check: cord ${depth+excess} cm; one third is ${depth-short} cm.`],{excess,short},{suffix:'cm'});}
  if(form===3){const shelf=r(60,110),diff=r(8,25),a=shelf+diff,b=shelf-diff;out(`A tall vase is placed on a shelf and a short vase stands on the floor. Their tops differ in height by ${a} cm. When the vases swap places, their tops differ by ${b} cm, with the vase on the shelf still higher. How high is the shelf?`,shelf,[`Let h be the shelf height and d the difference between vase heights.`,`h + d = ${a}; h − d = ${b}.`,`Add the equations: 2h = ${a+b}. So h = ${shelf} cm.`,`The vase difference is ${diff} cm; both conditions check.`],{a,b},{suffix:'cm'});}
 }else if(unit==='percent'){
  if(form===0){const price=100*r(2,12),rate=pick([9,10,15,20]),tax=price*rate/100;out(`A device costs $${price} before a ${rate}% charge. What is its price including that charge?`,price+tax,[`The charge is added, so the answer must be greater than $${price}.`,`${rate}% of ${price} = ${tax}.`,`Total = ${price} + ${tax} = $${price+tax}.`],{price,rate},{prefix:'$'});}
  if(form===1){const original=100*r(2,10),rate=pick([15,20,25,30]),paid=original*(100-rate)/100;out(`After a ${rate}% discount, a desk costs $${paid}. What was its price before the discount?`,original,[`${100-rate}% of the original is $${paid}.`,`Original = ${paid} ÷ ${(100-rate)/100} = $${original}.`,`Check by taking ${rate}% off the original.`],{rate,paid},{prefix:'$'});}
  if(form===2){const original=100*r(3,16),p=pick([10,20,30]),s=pick([10,20,25]),paid=round(original*(100-p)*(100-s)/10000);out(`A coat is reduced by ${p}%. A further ${s}% discount is applied to the reduced price. The final price is $${paid}. What was the original price?`,original,[`The two discounts act on different wholes.`,`The fraction left is ${(100-p)/100} × ${(100-s)/100} = ${round((100-p)*(100-s)/10000)}.`,`Original = ${paid} ÷ ${round((100-p)*(100-s)/10000)} = $${original}.`,`Do not add the discounts as if both acted on the original price.`],{p,s,paid},{prefix:'$'});}
  if(form===3){const a=10*r(4,16),difference=10*r(2,8),total=round(.9*a+1.2*(a+difference));out(`A centre originally has ${difference} more junior members than senior members. The senior membership then decreases by 10%, while the junior membership increases by 20%. There are now ${total} members altogether. How many senior members were there originally?`,a,[`Let the original senior count be x; juniors = x + ${difference}.`,`0.9x + 1.2(x + ${difference}) = ${total}.`,`2.1x = ${round(total-1.2*difference)}, so x = ${a}.`,`Check both changed groups separately before adding them.`],{difference,total});}
 }else if(unit==='remainders'){
  if(form===0){const whole=12*r(3,12);out(`A roll contains ${whole} m of ribbon. First 1/3 of it is used, then 1/4 of the remaining ribbon is used. How many metres remain?`,whole/2,[`After the first use, 2/3 remains: ${whole*2/3} m.`,`After the second use, 3/4 of that remains: ${whole/2} m.`,`The retained fraction is 2/3 × 3/4 = 1/2.`],{whole},{suffix:'m'});}
  if(form===1){const whole=4*r(10,35),fixed=r(5,15),left=whole*3/4-fixed;out(`A child spends 1/4 of some money and then another $${fixed}. There is $${left} left. How much money was there at first?`,whole,[`Undo the last purchase: ${left} + ${fixed} = ${whole*3/4}.`,`This is 3/4 of the original.`,`Original = ${whole*3/4} ÷ 3 × 4 = $${whole}.`],{fixed,left},{prefix:'$'});}
  if(form===2){const whole=24*r(3,11),fixed=r(5,18),left=whole/4-fixed;out(`A store sells 1/3 of its pencils in the morning, then 5/8 of those remaining in the afternoon. It gives away ${fixed} more pencils and has ${left} left. How many pencils did it have at first?`,whole,[`Before the giveaway there were ${left+fixed} pencils.`,`The fraction after both sales was 2/3 × 3/8 = 1/4.`,`Original = (${left} + ${fixed}) × 4 = ${whole}.`,`Check each sale using the current remainder, not the original count.`],{fixed,left});}
  if(form===3){const a=12*r(3,12),b=12*r(3,12),total=a+b,finalB=(b+a/3)*3/4;out(`Two boxes hold ${total} beads altogether. First 1/3 of the beads in A are moved to B. Then 1/4 of the beads now in B are moved to A. B finishes with ${finalB} beads. How many beads were in A initially?`,a,[`Undo the second move: B previously held ${finalB} ÷ 3 × 4 = ${finalB*4/3}.`,`At that moment A held ${total} − ${finalB*4/3} = ${a*2/3}.`,`That is 2/3 of A’s original amount.`,`Initially A held ${a*2/3} ÷ 2 × 3 = ${a}.`],{total,finalB});}
