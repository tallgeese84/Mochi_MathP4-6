 return header(u.title,phase)+`<article class="ep-question-sheet"><p class="ep-question-text">${esc(q.text)}</p>${F.diagram(q.figure,q.id)}${editor(q,v,false,done)}<div class="ep-actions">${done?'<button id="epNextPractice" class="ep-primary">Next learning step</button><button id="epMorePractice">Another question in this method</button>':'<button id="epCheckAnswer" class="ep-primary">Check my answer</button><button id="epHint">A hint</button><button id="epReveal">Show the worked solution</button>'}</div><p id="epFeedback" class="ep-feedback" role="status">${esc(feedback)}</p><div id="epSupport">${v.revealed?`<ol>${q.steps.map(s=>`<li>${esc(s)}</li>`).join('')}</ol>`:''}</div></article><div class="ep-actions"><button id="epRevisitLesson">Revisit this lesson</button><button id="epSaveHome">Save & return to my path</button><button id="epPrintPractice">Print a mixed practice set</button></div><p class="ep-note">${v.phase==='guided'?'Guided work is recorded as supported. ':''}A correct answer does not validate the explanation. ${v.seenBefore?'This exact question has appeared before; it is not new independent evidence.':'New numerical variants and new problem structures are tracked separately.'}</p>`;
}
function paperList(){
 const d=data();return header('Try it without a topic label.')+`<p class="ep-lead">The two starting checks are short and untimed. The three mixed papers each contain 24 questions with a 75-minute practice limit. These are original training formats, not the school’s announced test format.</p><div class="ep-paper-grid">${E.paperDefinitions.map(p=>{const saved=d.papers[p.id],score=saved?.submittedAt?E.scorePaper(d,p.id):null;return `<article class="ep-card"><h2>${esc(p.title)}</h2><p>${p.units.length} questions · ${p.minutes?p.minutes+' minutes':'untimed'}</p><p>${score?`${score.correct}/${score.total} · ${Math.round(score.percent)}%` : saved?'Already opened: resume with the original deadline.':'Reserved: questions have not been displayed in this pathway.'}</p><button data-start-paper="${p.id}" class="ep-primary">${score?'Review my paper':saved?'Resume':'Start'}</button>${score?`<p class="ep-note">${esc(score.status)}</p>`:''}</article>`;}).join('')}</div><details class="ep-details"><summary>How paper evidence is used</summary><p>Feedback and solutions appear only after submission. You can edit answers and mark questions for later. Leaving for a lesson or pausing converts the form to supported practice. The clock does not reset after reloading or closing a tab.</p><p>Each reserved form counts once. An opened or submitted paper is not presented as unseen again. The 85% target needs all three timed, independent forms, broad strand coverage, reviewed explanations and an external cross-check. It is not an admissions cutoff.</p></details>`;
}
function paperView(){
 const p=data().papers[view.paper];if(!p){view={kind:'papers'};return paperList();}if(p.submittedAt){view={kind:'results',paper:p.id};return resultsView();}
 const qs=E.paperQuestions(p.id),q=qs[p.index],def=E.paperDefinitions.find(x=>x.id===p.id),saved=p.answers[p.index]||{};
 return header(def.title,def.kind==='baseline'?'STARTING-POINT CHECK':'INDEPENDENT MIXED PAPER')+`<div class="ep-paper-meta"><strong>Question ${p.index+1} of ${qs.length}</strong><span id="epPaperClock" role="timer">${p.deadline?'Time remaining':'Untimed'}</span><span>${p.assisted||p.interrupted?'Supported practice':'No hints or feedback until submission'}</span></div><div class="ep-paper-map" aria-label="Question navigation">${qs.map((_,i)=>`<button data-paper-index="${i}" aria-label="Question ${i+1}${p.answers[i]?.answer?' answered':''}${p.flags.includes(i)?', marked for later':''}" ${p.index===i?'aria-current="step"':''} data-answered="${!!p.answers[i]?.answer}">${i+1}${p.flags.includes(i)?' *':''}</button>`).join('')}</div><article class="ep-question-sheet"><p class="ep-question-text">${esc(q.text)}</p>${F.diagram(q.figure,q.id)}${editor(q,saved,true)}<div class="ep-actions"><button id="epPaperPrev" ${p.index===0?'disabled':''}>Previous</button><button id="epPaperFlag">${p.flags.includes(p.index)?'Unmark':'Mark for later'}</button><button id="epPaperNext" ${p.index===qs.length-1?'disabled':''}>Next</button><button id="epSubmitPaper" class="ep-primary">Submit paper</button></div><p class="ep-note" id="epPaperSave">Answers and working save as you go. Submission freezes the paper.</p></article><button id="epPausePaper">Pause & use as practice</button><p class="ep-scope">Original practice format; not an official NUS High examination. The timer continues if this page is hidden.</p>`;
}
function resultsView(){
 const score=E.scorePaper(data(),view.paper);if(!score){view={kind:'papers'};return paperList();}const p=E.paperDefinitions.find(x=>x.id===view.paper);
 return header('Review the reasoning, not just the score.')+`<section class="ep-result-summary"><h2>${esc(p.title)}</h2><p class="ep-result-number">${score.correct}<small> / ${score.total}</small></p><p>${Math.round(score.percent)}% · ${esc(score.status)}</p><p>${score.unseen?'First exposure':'Previously exposed'} · ${score.independent?'No recorded help':'Support or interruption recorded'} · ${score.timed?'Within the practice limit':score.kind==='baseline'?'Untimed starting check':'Not a qualifying timed result'}</p></section><div class="ep-evidence-strip">${Object.entries(score.byStrand).filter(([,v])=>v.total).map(([k,v])=>`<span><strong>${v.correct}/${v.total}</strong>${esc(E.D.strands[k])}</span>`).join('')}</div><section class="ep-review-list">${score.results.map((a,i)=>`<details><summary>Question ${i+1} · ${a.correct?'Correct answer':a.blank?'Not answered':'Revisit'} · ${esc(E.unit(a.unit).title)}</summary><p>${esc(a.question)}</p><p><strong>Your answer:</strong> ${esc(a.answer||'Blank')}</p><p><strong>Your working:</strong> ${esc(a.working||'No typed working recorded.')}</p>${a.strokes.length?drawing(a.strokes):''}<p><strong>Answer:</strong> ${esc(a.reference)}</p><ol>${a.steps.map(s=>`<li>${esc(s)}</li>`).join('')}</ol><button data-lesson="${a.unit}">Learn this method</button><p class="ep-note">Review your explanation with an adult. A numerical match alone is not a reasoning grade.</p></details>`).join('')}</section><button id="epContinue" class="ep-primary">Choose my next learning step</button>`;
}
function wireNavigation(){
 $('epHome').onclick=()=>open('home');$('epLessons').onclick=()=>open('lessons');$('epPapers').onclick=()=>open('papers');$('epFoundations').onclick=()=>{leave();root.courseOpen('maths');};
 for(const b of host.querySelectorAll('[data-lesson]'))b.onclick=()=>open('lesson',b.dataset.lesson);
 for(const b of host.querySelectorAll('[data-foundation]'))b.onclick=()=>{leave();root.courseOpen('maths',b.dataset.foundation);};
 for(const b of host.querySelectorAll('[data-start-paper]'))b.onclick=()=>{
  capture();const id=b.dataset.startPaper,p=data().papers[id],other=Object.values(data().papers).find(x=>!x.submittedAt&&x.id!==id);
  if(other){message='Finish the saved paper before opening another.';open('paper',other.id);return;}
  if(p?.submittedAt){open('results',id);return;}
  if(!p&&!confirm('Start this reserved form now? Opening it records exposure. Mixed papers have a 75-minute practice limit; the short starting checks are untimed.'))return;
  E.startPaper(data(),id);open('paper',id);
 };
}
function wire(){
 if($('epContinue'))$('epContinue').onclick=nextRecommended;
 if($('epOpenProgress'))$('epOpenProgress').onclick=()=>{open('lessons');};
 if(view.kind==='lesson'){
  const l=E.lesson(data(),view.unit);for(const b of host.querySelectorAll('[data-page]'))b.onclick=()=>{capture();E.visit(data(),view.unit,+b.dataset.page);render();save(S);};
  if($('epExample'))$('epExample').onchange=()=>{exampleForm=+$('epExample').value;render();save(S);};
  for(const b of host.querySelectorAll('[data-concept]'))b.onclick=()=>{E.concept(data(),view.unit,+b.dataset.concept);render();save(S);};
  $('epLessonPrevious').onclick=()=>{capture();E.visit(data(),view.unit,l.page-1);render();save(S);};
  if($('epLessonNext'))$('epLessonNext').onclick=()=>{capture();E.visit(data(),view.unit,l.page+1);render();save(S);};
  if($('epCompleteLesson'))$('epCompleteLesson').onclick=()=>{capture();if(E.complete(data(),view.unit)){const id=view.unit;save(S);beginPractice(id,'guided');}};
  if($('epResumeDraft'))$('epResumeDraft').onclick=()=>open('practice',data().draft.unit);
  $('epLessonNotes').oninput=()=>capture(true);
 }
 if(view.kind==='practice'){
  wireEditor();
  if($('epCheckAnswer'))$('epCheckAnswer').onclick=()=>{
   capture();const result=E.respond(data());if(!result.ok){message=result.reason;render();return;}
   const a=result.attempt;message=a.correct?'Your answer checks out. Explain why your method works.':result.needsLesson?'Two attempts need a closer look. Open the lesson or worked solution before trying a fresh problem.':'Not yet. Check the relationship, calculation and units, then revise.';
   if(a.phase==='guided'&&root.MochiPlanner){const d=MochiPlanner.day(MochiPlanner.init(S),'maths');d.exitIds=[...new Set([...d.exitIds,'entrance:'+a.id])].slice(-8);d.updatedAt=Date.now();}
   save(S);render();
  };
  if($('epHint'))$('epHint').onclick=()=>{capture();E.help(data());$('epSupport').innerHTML='<p>'+esc(E.unit(view.unit).ideas[0])+'</p><p>'+esc(E.unit(view.unit).why)+'</p>';save(S);};
  if($('epReveal'))$('epReveal').onclick=()=>{capture();E.help(data(),true);render();save(S);};
  if($('epNextPractice'))$('epNextPractice').onclick=()=>{capture();E.finishPractice(data());save(S);nextRecommended();};
  if($('epMorePractice'))$('epMorePractice').onclick=()=>{capture();const id=view.unit;E.finishPractice(data());beginPractice(id);};
  $('epRevisitLesson').onclick=()=>{capture();E.help(data());open('lesson',view.unit);};$('epSaveHome').onclick=()=>open('home');$('epPrintPractice').onclick=printPractice;
 }
 if(view.kind==='paper'){
  wireEditor();const p=data().papers[view.paper],qs=E.paperQuestions(p.id);
  const go=i=>{capture();p.index=i;p.updatedAt=Date.now();render();save(S);};
  for(const b of host.querySelectorAll('[data-paper-index]'))b.onclick=()=>go(+b.dataset.paperIndex);
  $('epPaperPrev').onclick=()=>go(Math.max(0,p.index-1));$('epPaperNext').onclick=()=>go(Math.min(qs.length-1,p.index+1));
  $('epPaperFlag').onclick=()=>{capture();p.flags=p.flags.includes(p.index)?p.flags.filter(x=>x!==p.index):[...p.flags,p.index];render();save(S);};
  $('epSubmitPaper').onclick=()=>{capture();const blanks=qs.filter((_,i)=>!p.answers[i]?.answer.trim()).length;if(!confirm(`Submit this paper${blanks?' with '+blanks+' unanswered question(s)':''}? You cannot edit it after submission.`))return;E.submitPaper(data(),p.id);save(S);open('results',p.id);};
  $('epPausePaper').onclick=()=>{capture();if(!confirm('Pause and continue as supported practice? The paper will no longer count as an independent timed check.'))return;E.interruptPaper(data(),p.id);open('home');};
  tickPaper();
 }
 requestAnimationFrame(drawInk);
}
function wireEditor(){
 $('epAnswer').oninput=$('epWorking').oninput=()=>capture(true);
 $('epAnswer').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();if(view.kind==='practice')$('epCheckAnswer')?.click();else capture(true);}};
 for(const b of host.querySelectorAll('[data-answer]'))b.onclick=()=>{$('epAnswer').value=b.dataset.answer;host.querySelectorAll('[data-answer]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));capture(true);};
 if($('epGuess'))$('epGuess').onchange=()=>capture(true);
 $('epKeyboard').onclick=()=>{pen=false;$('epInkArea').hidden=true;$('epKeyboard').setAttribute('aria-pressed','true');$('epStylus').setAttribute('aria-pressed','false');$('epWorking').focus();};
 $('epStylus').onclick=()=>{pen=true;$('epInkArea').hidden=false;$('epKeyboard').setAttribute('aria-pressed','false');$('epStylus').setAttribute('aria-pressed','true');drawInk();};
 const cv=$('epCanvas');cv.onpointerdown=e=>{if(pointer!==null||(e.pointerType==='touch'&&$('epPenOnly').checked)||e.button>0)return;e.preventDefault();pointer=e.pointerId;cv.setPointerCapture?.(e.pointerId);strokes.push([]);strokes=strokes.slice(-60);cv.onpointermove(e);};
 cv.onpointermove=e=>{if(e.pointerId!==pointer)return;e.preventDefault();const r=cv.getBoundingClientRect(),s=strokes.at(-1);if(!r.width||!r.height||s.length>=300)return;s.push([Math.max(0,Math.min(1,(e.clientX-r.left)/r.width)),Math.max(0,Math.min(1,(e.clientY-r.top)/r.height))]);drawInk();};
 cv.onpointerup=cv.onpointercancel=e=>{if(e.pointerId!==pointer)return;pointer=null;capture(true);};
 $('epUndoInk').onclick=()=>{strokes.pop();drawInk();capture(true);};$('epClearInk').onclick=()=>{if(strokes.length&&!confirm('Clear this drawing? Typed working stays.'))return;strokes=[];drawInk();capture(true);};
}
function drawInk(){const cv=$('epCanvas');if(!cv||!pen)return;const ctx=cv.getContext('2d');if(!ctx)return;const r=cv.getBoundingClientRect();if(!r.width)return;const dpr=Math.min(root.devicePixelRatio||1,2);cv.width=Math.round(r.width*dpr);cv.height=Math.round(r.height*dpr);ctx.clearRect(0,0,cv.width,cv.height);ctx.strokeStyle='#29232f';ctx.lineWidth=2.2*dpr;ctx.lineCap='round';ctx.lineJoin='round';for(const s of strokes){ctx.beginPath();s.forEach(([x,y],i)=>i?ctx.lineTo(x*cv.width,y*cv.height):ctx.moveTo(x*cv.width,y*cv.height));ctx.stroke();}}
function tickPaper(){
 if(paused||!data().papers)return;const active=Object.values(data().papers).filter(p=>!p.submittedAt&&p.deadline);
 for(const p of active){const remaining=p.deadline-Date.now();if(remaining<=0){E.submitPaper(data(),p.id,Math.max(p.deadline,Date.now()));save(S);if(visible()&&view.kind==='paper'&&view.paper===p.id)open('results',p.id);continue;}if(visible()&&view.kind==='paper'&&view.paper===p.id&&$('epPaperClock')){$('epPaperClock').textContent=`${Math.floor(remaining/60000)}:${String(Math.floor(remaining/1000)%60).padStart(2,'0')} remaining`;$('epPaperClock').dataset.warning=String(remaining<300000);}}
}
function printPractice(){
 capture();const seed=Math.floor(Math.random()*4294967296),qs=E.D.units.filter((_,i)=>i%2===0).map((u,i)=>E.B.make(u.id,1,(seed+i*7919)>>>0));qs.forEach(q=>data().seen[q.fingerprint]=data().seen[q.fingerprint]||Date.now());save(S);
