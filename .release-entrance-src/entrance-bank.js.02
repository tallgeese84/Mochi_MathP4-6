  if(form===0){const b=2*r(5,13),h=r(6,15);out(`Triangle ABC has base BC = ${b} cm and perpendicular height ${h} cm. Find its area.`,b*h/2,[`Area = base × perpendicular height ÷ 2.`,`${b} × ${h} ÷ 2 = ${b*h/2} cm².`],{b,h},{suffix:'cm²',figure:{kind:'triangle',b,h,alt:`Triangle ABC with base ${b} cm and marked perpendicular height ${h} cm.`}});}
  if(form===1){const a=r(2,6),b=r(7,12),unitArea=r(6,18);out(`B, D and C lie in that order on a straight line, with BD = ${a} cm and DC = ${b} cm. Triangle ABD has area ${a*unitArea} cm². What is the area of triangle ADC?`,b*unitArea,[`Triangles ABD and ADC have a common vertex and collinear bases, so their heights are equal.`,`Area per centimetre of base = ${a*unitArea} ÷ ${a} = ${unitArea}.`,`Area ADC = ${b} × ${unitArea} = ${b*unitArea} cm².`],{a,b,area:a*unitArea},{suffix:'cm²',figure:{kind:'split',parts:[a,b],alt:`Triangle ABC divided by AD, with BD ${a} cm and DC ${b} cm.`}});}
  if(form===2){const a=r(2,6),b=r(3,7),c=r(2,8),k=r(4,12),total=(a+b+c)*k;out(`The base BC of triangle ABC is divided at D and E, in the order B, D, E, C. BD = ${a} cm, DE = ${b} cm and EC = ${c} cm. The whole triangle has area ${total} cm². Find the shaded area ADE.`,b*k,[`All three small triangles have the same perpendicular height.`,`The total base is ${a+b+c} cm.`,`ADE occupies ${b}/${a+b+c} of the total: ${total} × ${b}/${a+b+c} = ${b*k} cm².`],{a,b,c,total},{suffix:'cm²',figure:{kind:'split',parts:[a,b,c],shade:1,alt:`Triangle ABC split into bases ${a}, ${b} and ${c} cm. Only middle triangle ADE is shaded.`}});}
  if(form===3){const a=r(3,7),b=r(4,9),s=r(4,10),areaA=a*s,whole=(a+b)*s;out(`D lies on BC of triangle ABC. The areas of triangles ABD and ADC are ${areaA} cm² and ${b*s} cm². If BC = ${2*(a+b)} cm, find DC.`,2*b,[`With equal heights, BD:DC = ${areaA}:${b*s} = ${a}:${b}.`,`The whole base represents ${a+b} parts.`,`DC = ${2*(a+b)} × ${b}/${a+b} = ${2*b} cm.`],{areaA,areaB:b*s,base:2*(a+b)},{suffix:'cm',figure:{kind:'triangle',b:2*(a+b),alt:`Triangle ABC with D on base BC and segment AD drawn. Areas are given in the question.`}});q.figure={kind:'split',parts:[a,b],alt:`Triangle ABC divided by AD. Use the areas and total BC stated in the question.`};q.figure.hideMeasures=true;}
 }else if(unit==='decomposition'){
  if(form===0){const w=r(14,24),h=r(10,13),b=r(1,3),answer=w*h-(w-2*b)*(h-2*b);out(`A rectangular plot is ${w} m by ${h} m. A path ${b} m wide runs just inside all four edges. Find the area of the path.`,answer,[`Inner dimensions are ${w-2*b} m and ${h-2*b} m: subtract the border at both ends.`,`Path = whole − inner rectangle.`,`${w*h} − ${(w-2*b)*(h-2*b)} = ${answer} m².`],{w,h,b},{suffix:'m²',figure:{kind:'border',w,h,b}});}
  if(form===1){const w=2*r(6,13),h=2*r(4,8),position=pick([.25,.4,.65]);out(`ABCD is a rectangle of length ${w} cm and breadth ${h} cm. E and G lie on AB and DC respectively, with EG perpendicular to AB. F and H lie on BC and AD. Find the shaded area EFGH.`,w*h/2,[`Draw EG. It is a vertical base of length ${h} cm.`,`Triangles EFG and EHG have horizontal heights that add to ${w} cm.`,`Their combined area is 1/2 × ${h} × ${w} = ${w*h/2} cm².`],{w,h,position},{suffix:'cm²',figure:{kind:'inscribed',w,h,position,alt:`Rectangle ABCD. E on top and G on bottom are directly aligned. F is on the right, H on the left; EFGH is shaded.`}});}
  if(form===2){const k=pick([2,3]),side=(k*k+1)*r(2,5),answer=side*side*(k-1)**2/(k*k+1);out(`ABCD is a square of side ${side} cm. Points E, F, G and H lie on BC, CD, DA and AB respectively, with BE/BC = CF/CD = DG/DA = AH/AB = 1/${k}. Segments AE, BF, CG and DH enclose a small central square. Find its area.`,answer,[`Let P be the intersection of AE and BF. A quarter-turn carries AE to BF, so these lines are perpendicular.`,`Triangles ABP and BEP are similar right triangles: corresponding angles match. Their hypotenuses AB and BE have ratio ${k}:1, so their areas have ratio ${k*k}:1.`,`Together those two triangles form ABE. Area ABE = ${side} × ${side/k} ÷ 2 = ${side*side/(2*k)} cm².`,`The small overlap triangle BEP is 1/${k*k+1} of ABE: ${side*side/(2*k)}/${k*k+1} cm².`,`The four congruent corner triangles ABE, BCF, CDG and DAH cover everything outside the centre. Neighbouring corner triangles overlap in four copies of BEP.`,`Centre = whole square − four corner triangles + four overlaps.`,`Area = ${side*side} − 4 × ${side*side/(2*k)} + 4 × (${side*side/(2*k)}/${k*k+1}) = ${answer} cm². The overlaps are added back because subtracting both corner triangles removed them twice.`],{k,side},{suffix:'cm²',figure:{kind:'central',k,side,alt:`Square ABCD with E,F,G,H dividing successive sides at fraction 1/${k}; AE,BF,CG,DH enclose the shaded central square.`}});}
  if(form===3){const a=r(8,13),b=r(6,10),ox=r(2,4),oy=r(2,4);out(`Two squares have sides ${a} cm and ${b} cm. Their overlapping region is a rectangle ${ox} cm by ${oy} cm, as shown. What is the total area covered by the two squares?`,a*a+b*b-ox*oy,[`Sum of square areas = ${a*a} + ${b*b} = ${a*a+b*b}.`,`The overlap, ${ox*oy} cm², has been counted twice.`,`Covered area = ${a*a+b*b} − ${ox*oy} = ${a*a+b*b-ox*oy} cm².`],{a,b,ox,oy},{suffix:'cm²',figure:{kind:'overlap',a,b,ox,oy}});}
 }else if(unit==='circles'){
  if(form===0){const radius=r(3,12);out(`A semicircle has radius ${radius} cm. Find its full perimeter, including the straight edge. Give your answer in terms of π.`,{a:2*radius,b:radius},[`The curved part is half of 2πr, or ${radius}π cm.`,`The straight diameter is ${2*radius} cm.`,`Perimeter = ${2*radius} + ${radius}π cm.`],{radius},{suffix:'cm',answerLabel:`${2*radius} + ${radius}π`});}
  if(form===1){const ds=[2*r(3,8),2*r(2,7),2*r(3,9)],b=ds.reduce((a,b)=>a+b,0)/2;out(`Three semicircular arcs have diameters ${ds.join(', ')} cm respectively. Find their total curved length, excluding the straight diameter segments. Give the answer in terms of π.`,{a:0,b},[`Each arc length is π × diameter ÷ 2.`,`Total = (${ds.join(' + ')})π ÷ 2 = ${b}π cm.`],{ds},{suffix:'cm',answerLabel:`${b}π`,figure:{kind:'semicircles',ds}});}
  if(form===2){const k=r(2,5),smallArea=r(5,20);out(`The radius of a large circle is ${k} times the radius of a small circle. The small circle has area ${smallArea}π cm². What is the area of the large circle in terms of π?`,{a:0,b:smallArea*k*k},[`Area scales as the square of radius.`,`Area multiplier = ${k} × ${k} = ${k*k}.`,`Large area = ${smallArea}π × ${k*k} = ${smallArea*k*k}π cm².`],{k,smallArea},{suffix:'cm²',answerLabel:`${smallArea*k*k}π`,figure:{kind:'circleRatio',k}});}
  if(form===3){const side=2*r(4,11);out(`A circle is inscribed in a square of side ${side} cm, touching all four sides. Find the shaded area inside the square but outside the circle. Give an exact answer in terms of π.`,{a:side*side,b:-side*side/4},[`The circle’s diameter is ${side} cm, so its radius is ${side/2} cm.`,`Square area = ${side*side}; circle area = ${side*side/4}π.`,`Shaded area = ${side*side} − ${side*side/4}π cm².`],{side},{suffix:'cm²',answerLabel:`${side*side} − ${side*side/4}π`,figure:{kind:'circleSquare',side}});}
 }else if(unit==='angles'){
  if(form===0||form===1){const apex=2*r(20,60),base=(180-apex)/2,answer=form===0?base:180-base;out(`Triangle ABC has AB = AC and angle BAC = ${apex}°. ${form===0?'Find angle ABC.':'BC is extended beyond C. Find the exterior angle between CA and the extension of BC at C.'}`,answer,[`The equal base angles share 180° − ${apex}° = ${180-apex}°.`,`Each base angle is ${base}°.` ,...(form===1?[`The exterior angle and interior base angle form 180°: ${180-base}°.`]:[])],{apex},{suffix:'°',figure:{kind:'isosceles',apex,exterior:form===1}});}
  if(form===2){const angleC=2*r(17,37),tip=(126-angleC)/2;out(`Five points on a circle are joined in order A–C–E–B–D–A to form a five-point star. The angle at tip A is ${tip}°. Find the sum of the other four tip angles.`,180-tip,['Trace the indicated star in one continuous route.','The total turning is 720°, or two complete turns.','The five tip angles therefore sum to 5 × 180° − 720° = 180°.',`Subtract the given tip: 180° − ${tip}° = ${180-tip}°.`],{tip}, {suffix:'°',figure:{kind:'star',angleC,alt:'Five points A,B,C,D,E around a circle, connected by skipping one point each time to form a five-point star.'}});}
  if(form===3){const theta=2*r(15,35);out(`ABCD is a square. Triangle BCE is constructed outside the square with BC = BE and angle CBE = ${theta}°. Segment AE is drawn. Find angle BAE.`,(90-theta)/2,['AB = BC = BE, so triangle ABE is isosceles.',`Angle ABE = 90° + ${theta}° = ${90+theta}° because E is outside the square.`,`The other two angles are equal: (180° − ${90+theta}°) ÷ 2 = ${(90-theta)/2}°.`],{theta}, {suffix:'°',figure:{kind:'squareTriangle',theta,alt:`Square ABCD with A lower left, B lower right, C upper right, D upper left. Triangle BCE is outside on the right with BC = BE and angle CBE ${theta} degrees. Segment AE is drawn.`}});}
 }else if(unit==='spatial'){
  const labels=[1,2,3,4,5,6];for(let i=5;i>0;i--){const j=r(0,i);[labels[i],labels[j]]=[labels[j],labels[i]];}
  if(form===0||form===1){const target=form===0?0:3,opposite={0:2,2:0,1:5,5:1,3:4,4:3};out(`The illustrated net folds into a cube. Which numbered face is opposite face ${labels[target]}?`,labels[opposite[target]],[`Fold the horizontal row around the centre face, then fold the vertical strip.`,`The opposite pairs are ${labels[0]}–${labels[2]}, ${labels[1]}–${labels[5]}, and ${labels[3]}–${labels[4]}.`,`Face ${labels[target]} is opposite ${labels[opposite[target]]}.`],{labels,target},{figure:{kind:'net',labels,alt:`Net with horizontal row ${labels[0]},${labels[1]},${labels[2]}; ${labels[3]} above the centre; ${labels[4]},${labels[5]} below it in that order.`}});}
  if(form===2||form===3){const views=[[labels[0],labels[2],labels[1]],[labels[3],labels[2],labels[4]]];out(`The pictures show two orientations of the same cube. Its faces are numbered 1 to 6, once each. Which number is opposite face ${labels[2]}?`,labels[5],[`Face ${labels[2]} touches ${labels[0]} and ${labels[1]} in one view, and ${labels[3]} and ${labels[4]} in the other.`,`These are its four different neighbours.`,`The remaining face, ${labels[5]}, must be opposite it.`],{labels,views},{figure:{kind:'views',views,alt:`View 1: top ${views[0][0]}, front ${views[0][1]}, right ${views[0][2]}. View 2: top ${views[1][0]}, front ${views[1][1]}, right ${views[1][2]}.`}});}
 }else if(unit==='volume'){
  if(form===0){const edge=r(2,9);out(`A solid cube has volume ${edge**3} cm³. Find its edge length.`,edge,[`Find a length e such that e × e × e = ${edge**3}.`,`${edge} × ${edge} × ${edge} = ${edge**3}, so the edge is ${edge} cm.`,`Dividing by 3 would not undo multiplication of three equal lengths.`],{volume:edge**3},{suffix:'cm',figure:{kind:'cubes',alt:'A cube with an unknown edge length. The volume is given in the question.'}});}
  if(form===1){const cubes=r(3,9),edge=r(2,5);out(`${cubes} identical cubes, each of edge ${edge} cm, are joined in a straight row with complete faces touching. Find the total exposed surface area of the resulting solid.`,(4*cubes+2)*edge*edge,[`Separate cubes have ${6*cubes} faces.`,`There are ${cubes-1} joins, each hiding two faces.`,`Exposed faces = ${6*cubes} − ${2*(cubes-1)} = ${4*cubes+2}.`,`Each face has area ${edge*edge}; total = ${(4*cubes+2)*edge*edge} cm².`],{cubes,edge},{suffix:'cm²'});}
  if(form===2){const edge=r(5,10),cut=r(1,edge-2);out(`A cube of edge ${edge} cm has a smaller cube of edge ${cut} cm removed from one corner. The removed cube shares that corner and its three edges follow the original edges. What is the total surface area of the remaining solid?`,6*edge*edge,[`The original surface area is 6 × ${edge}² = ${6*edge*edge} cm².`,`Three ${cut} × ${cut} outside squares are removed.`,`Three equal inside squares are exposed. These changes cancel.`,`Total surface area remains ${6*edge*edge} cm².`],{edge,cut},{suffix:'cm²'});}
  if(form===3){const edge=r(5,9),hole=r(1,edge-2);out(`A straight square tunnel of side ${hole} cm passes completely through a cube of edge ${edge} cm, perpendicular to its front and back faces. The opening lies strictly inside both faces. Find the remaining solid’s total surface area, including the tunnel walls.`,6*edge*edge-2*hole*hole+4*hole*edge,[`Original outside area = 6 × ${edge}² = ${6*edge*edge}.`,`Remove two openings: 2 × ${hole}² = ${2*hole*hole}.`,`Add four tunnel walls: 4 × ${hole} × ${edge} = ${4*hole*edge}.`,`Total = ${6*edge*edge-2*hole*hole+4*hole*edge} cm².`],{edge,hole},{suffix:'cm²',figure:{kind:'cubes',edge,hole,alt:`Cube of edge ${edge} cm; a shaded square of side ${hole} cm on the front indicates a straight tunnel to the back.`}});}
 }else if(unit==='factors'){
  const a=r(1,4),b=r(1,3),N=2**a*3**b;
  if(form===0)out(`Find the number of positive factors of ${N}.`,(a+1)*(b+1),[`${N} = 2^${a} × 3^${b}.`,`A factor chooses an exponent of 2 from 0 to ${a}, and an exponent of 3 from 0 to ${b}.`,`Number of choices = ${a+1} × ${b+1} = ${(a+1)*(b+1)}.`],{a,b,N});
  if(form===1){const x=2**a*3,y=2*3**b*5;out(`What is the least positive whole number divisible by both ${x} and ${y}?`,lcm(x,y),[`Prime factors: ${x} = 2^${a} × 3; ${y} = 2 × 3^${b} × 5.`,`Use the greatest exponent needed for every prime.`,`LCM = 2^${a} × 3^${b} × 5 = ${lcm(x,y)}.`],{x,y});}
  if(form===2){const p=pick([3,5,7]);out(`Find the smallest positive integer that is divisible by ${p} and has exactly 6 positive factors.`,Math.min(p**5,p*p*2,4*p),['Exactly six factors requires prime exponents 5, or 2 and 1. ',`Compare ${p}^5, ${p}² × 2, and 2² × ${p}.`,`The least is ${Math.min(p**5,p*p*2,4*p)}. Its factor count is 3 × 2 = 6.`],{p});}
  if(form===3){const c=r(1,2),value=N*5**c;out(`How many positive factors of ${value} are divisible by 6?`,a*b*(c+1),[`${value} = 2^${a} × 3^${b} × 5^${c}.`,`A factor divisible by 6 must use at least one 2 and at least one 3.`,`There are ${a} choices for the exponent of 2, ${b} for 3, and ${c+1} for 5.`,`Total = ${a*b*(c+1)}.`],{a,b,c,value});}
 }else if(unit==='cycles'){
  if(form===0){const divisor=r(3,12),N=r(15,40)*divisor+r(0,divisor-1);out(`What is the remainder when ${N} is divided by ${divisor}?`,N%divisor,[`${N} = ${divisor} × ${Math.floor(N/divisor)} + ${N%divisor}.`,`The remainder is ${N%divisor}, smaller than the divisor.`],{N,divisor});}
  if(form===1){const ds=pick([[3,4,7],[4,5,6],[3,5,8],[5,6,7]]),multiple=ds.reduce(lcm);out(`Find the smallest positive whole number which leaves remainder ${ds[0]-1} when divided by ${ds[0]}, remainder ${ds[1]-1} when divided by ${ds[1]}, and remainder ${ds[2]-1} when divided by ${ds[2]}.`,multiple-1,[`Adding one gives a multiple of ${ds.join(', ')}.`,`Their least common multiple is ${multiple}.`,`Required number = ${multiple} − 1 = ${multiple-1}. Check each remainder.`],{ds});}
  if(form===2){const [base,divisor]=pick([[2,7],[3,5],[2,5],[3,7]]),n=r(21,60),m=r(61,99),answer=(modPow(base,n,divisor)+modPow(base,m,divisor))%divisor;let cycle=[],v=1;do{v=v*base%divisor;cycle.push(v);}while(v!==1&&cycle.length<20);out(`A sequence begins ${base} and each term is obtained by multiplying the previous term by ${base}. What is the remainder when the sum of its ${n}th and ${m}th terms is divided by ${divisor}?`,answer,[`The remainders repeat in a cycle: ${cycle.join(', ')}.`,`The cycle length is ${cycle.length}. The terms have remainders ${modPow(base,n,divisor)} and ${modPow(base,m,divisor)}.`,`Add them and take the remainder again: ${answer}.`],{base,divisor,n,m});}
  if(form===3){const a=r(3,8),b=a+r(1,5),c=r(7,12),after=r(50,120),period=lcm(lcm(a,b),c),answer=(Math.floor(after/period)+1)*period;out(`Three lights flash together at the start. They then flash every ${a}, ${b} and ${c} seconds respectively. At how many seconds after the start will they first flash together strictly after ${after} seconds?`,answer,[`Simultaneous flashes repeat every LCM(${a}, ${b}, ${c}) = ${period} seconds.`,`Choose the first multiple of ${period} greater than ${after}.`,`That is ${answer} seconds after the start.`],{a,b,c,after},{suffix:'seconds'});}
 }else if(unit==='counting'){
