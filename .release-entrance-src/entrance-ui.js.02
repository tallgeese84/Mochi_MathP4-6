 let print=$('epPrint');if(!print){print=document.createElement('section');print.id='epPrint';document.body.append(print);}print.innerHTML='<h1>Mochi · Mixed reasoning practice</h1><p>Original learning questions. Not an official NUS High paper. This practice set is separate from the reserved in-app forms.</p>'+qs.map((q,i)=>`<article><h2>Question ${i+1}</h2><p>${esc(q.text)}</p>${F.diagram(q.figure,q.id+'-print')}<div class="ep-print-working"></div><p>Answer: _______________________</p></article>`).join('');root.print();
}
function paintParent(){
 if(!$('entranceParent')?.open)return;const d=data(),report=E.report(d),recent=d.attempts.slice(-60).reverse(),sig=JSON.stringify([report, d.reviews, d.external]);if(sig===lastParent)return;lastParent=sig;
 $('entranceParentBody').innerHTML=`<p><strong>June 2027 mathematics preparation.</strong> ${report.qualifyingPapers}/3 internal paper targets; ${report.reviewedStrands}/4 strands with an independently correct explanation marked valid by an adult; ${report.externalChecks} qualifying parent-reported external checks.</p><p>${report.internalTarget?'Internal training target evidence is recorded. Confirm it against external unseen material.':'Readiness is not yet established by the recorded evidence.'} No admission probability or percentile is calculated.</p><div class="ep-table-wrap"><table><thead><tr><th>Method</th><th>Next stage</th><th>Independent application / transfer / delayed</th></tr></thead><tbody>${report.units.map(u=>`<tr><td>${esc(u.title)}</td><td>${esc(u.stage)}</td><td>${u.apply} / ${u.transfer} / ${u.delayed}</td></tr>`).join('')}</tbody></table></div><label for="epReviewPick">Review a recorded response</label><select id="epReviewPick"><option value="">Choose a response</option>${recent.map(a=>`<option value="${esc(a.id)}">${esc(E.unit(a.unit).title)} · ${a.correct?'correct answer':'revisit'} · ${new Date(a.answeredAt).toLocaleDateString()}</option>`).join('')}</select><div id="epReviewDetail"></div><details><summary>Record an external unseen paper</summary><p>Parent-entered evidence is kept separate from app marking. Use previously unseen material and record the actual conditions.</p><label>Paper name <input id="epExternalName" maxlength="150"></label><label>Marks earned <input id="epExternalScore" type="number" min="0" step="any"></label><label>Total marks <input id="epExternalTotal" type="number" min="1" step="any"></label><label><input type="checkbox" id="epExternalUnseen"> Previously unseen</label><label><input type="checkbox" id="epExternalIndependent"> No help</label><label><input type="checkbox" id="epExternalTimed"> Completed within its time limit</label><button id="epSaveExternal">Save external result</button><p id="epExternalStatus" role="status"></p>${d.external.map(x=>`<p>${esc(x.name)}: ${x.score}/${x.total}, ${x.unseen?'unseen':'familiar'}, ${x.independent?'independent':'supported'}, ${x.timed?'timed':'untimed'}.</p>`).join('')}</details><p class="ep-note">${report.limits.map(esc).join(' ')}</p>`;
 $('epReviewPick').onchange=()=>{const a=d.attempts.find(a=>a.id===$('epReviewPick').value);if(!a){$('epReviewDetail').innerHTML='';return;}const v=a.responses.at(-1),review=d.reviews[a.id];$('epReviewDetail').innerHTML=`<p><strong>${esc(a.question)}</strong></p><p>Submitted answer: ${esc(v.answer)}. ${a.independent?'No recorded answer help.':'Support, a revision or a conflict is recorded.'}</p><p>${esc(v.working||'No typed explanation recorded.')}</p>${drawing(v.strokes)}${a.reflection?'<p>Later notes: '+esc(a.reflection)+'</p>':''}<label for="epReviewVerdict">Adult review of the explanation</label><select id="epReviewVerdict">${[['unreviewed','Not reviewed'],['valid','Reasoning is valid'],['needs-discussion','Needs discussion']].map(([id,label])=>`<option value="${id}" ${review?.verdict===id?'selected':''}>${label}</option>`).join('')}</select><textarea id="epReviewNote" rows="2" maxlength="1500" aria-label="Adult review note">${esc(review?.note||'')}</textarea><button id="epSaveReview">Save review</button><p id="epReviewStatus" role="status"></p>`;$('epSaveReview').onclick=()=>{E.review(d,a.id,$('epReviewVerdict').value,$('epReviewNote').value);save(S);$('epReviewStatus').textContent='Review saved separately from numerical marking.';lastParent='';};};
 $('epSaveExternal').onclick=()=>{try{E.addExternal(d,{name:$('epExternalName').value,score:Number($('epExternalScore').value),total:Number($('epExternalTotal').value),unseen:$('epExternalUnseen').checked,independent:$('epExternalIndependent').checked,timed:$('epExternalTimed').checked});save(S);lastParent='';paintParent();}catch(e){$('epExternalStatus').textContent=e.message;}};
}
function init(){
 E.init(S);host=document.createElement('main');host.id='viewEntrance';host.className='entrance-view';host.hidden=true;$('viewMaths').before(host);
 const details=document.createElement('details');details.id='entranceParent';details.className='study-details';details.innerHTML='<summary>Entrance pathway · evidence and external benchmarks</summary><div id="entranceParentBody"></div>';$('parentEvidence').before(details);details.ontoggle=paintParent;
 const entry=document.createElement('button');entry.id='entranceReturn';entry.className='course-secondary entrance-return';entry.textContent='Entrance pathway · June 2027';entry.onclick=()=>open('home');$('courseReturn').before(entry);
 const bind=()=>{$('subjectMaths').onclick=()=>open('home');};bind();
 document.addEventListener('mochi:cloud-merged',()=>{bind();lastParent='';if(visible())render();paintParent();});
 document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')capture(true);else tickPaper();});root.addEventListener('pagehide',()=>capture(true));root.addEventListener('resize',drawInk);
 $('adultBtn').addEventListener('click',()=>{if(visible()&&view.kind==='paper'){capture();E.interruptPaper(data(),view.paper);save(S);}});
 root.MochiEntranceUI={open,leave,visible,capture,view:()=>({...view}),next:nextRecommended,practice:beginPractice,pause:()=>{capture();paused=true;},refresh:()=>{paused=false;bind();lastParent='';open('home');paintParent();},currentUnit:()=>view.unit};
 const reset=$('resetBtn').onclick;$('resetBtn').onclick=()=>{const before=S.learning;reset();if(before!==S.learning){S.entrance=E.fresh();paused=false;save(S);open('home');}};
 setInterval(tickPaper,500);open('home');
}
if(root.MochiReady)init();else document.addEventListener('mochi:ready',init,{once:true});
})(window);
