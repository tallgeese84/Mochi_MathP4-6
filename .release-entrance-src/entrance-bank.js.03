  if(form===1){const n=r(15,45),sticks=3*n+1;out(`A straight row of adjoining matchstick squares uses ${sticks} sticks. Every neighbouring pair shares one complete side. How many squares are in the row?`,n,[`For n squares, count = 4 + 3(n−1) = 3n+1.`,`3n + 1 = ${sticks}; n = (${sticks} − 1)/3 = ${n}.`],{sticks},{figure:{kind:'sticks'}});}
  if(form===2){const n=r(12,35),first=r(2,6),increment=r(2,4);out(`A tile staircase has ${n} rows. The top row has ${first} tiles, and each row below has ${increment} more tiles than the preceding row. How many tiles are there altogether?`,n*(2*first+(n-1)*increment)/2,[`Bottom row = ${first} + (${n} − 1) × ${increment} = ${first+(n-1)*increment}.`,`The rows form an arithmetic sequence.`,`Total = ${n} × (${first} + ${first+(n-1)*increment}) ÷ 2 = ${n*(2*first+(n-1)*increment)/2}.`],{n,first,increment});}
