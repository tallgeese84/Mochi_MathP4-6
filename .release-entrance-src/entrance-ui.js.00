/* DSA-benchmarked learning path. All teaching, marking, diagrams and ink work offline. */
(function(root){
'use strict';
const E=root.MochiEntrance,F=root.MochiEntranceFigures,$=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let view={kind:'home'},host=null,paused=false,pen=false,pointer=null,strokes=[],message='',exampleForm=0,lastParent='';
const data=()=>E.init(S),visible=()=>!!host&&!host.hidden;
function drawing(ink){return `<svg viewBox="0 0 800 320" class="ep-saved-ink" aria-label="Saved handwritten working">${(ink||[]).map(s=>`<polyline points="${s.map(([x,y])=>`${x*800},${y*320}`).join(' ')}" fill="none" stroke="#29232f" stroke-width="2.4" stroke-linecap="round"/>`).join('')}</svg>`;}
function capture(persist=false){
 if(paused||!visible())return;
 if(view.kind==='practice'&&data().draft&&$('epAnswer')){E.touchDraft(data(),{answer:$('epAnswer').value,working:$('epWorking').value,strokes,guess:$('epGuess')?.checked});const a=data().attempts.find(x=>x.id===data().draft.id);if(a?.correct&&$('epWorking').value!==(a.responses.at(-1).working||'')){a.reflection=$('epWorking').value.slice(0,6000);a.reflectionInk=E.ink(strokes);a.reflectionAt=Date.now();}}
 if(view.kind==='paper'&&$('epAnswer')){const p=data().papers[view.paper];if(p&&!p.submittedAt)E.savePaperAnswer(data(),p.id,p.index,{answer:$('epAnswer').value,working:$('epWorking').value,strokes});}
 if(view.kind==='lesson'&&$('epLessonNotes')){const l=E.lesson(data(),view.unit);l.notes=$('epLessonNotes').value.slice(0,6000);l.updatedAt=Date.now();}
 if(persist)save(S);
}
function leave(){
 if(!visible()||paused)return;capture();if(view.kind==='paper')E.interruptPaper(data(),view.paper);host.hidden=true;document.body.classList.remove('entrance-active','entrance-paper');save(S);
}
function open(kind='home',id){
 if(!host||paused)return;
 capture();if(view.kind==='paper'&&kind!=='paper'&&kind!=='results')E.interruptPaper(data(),view.paper);
 if(typeof courseLeave==='function')courseLeave();if(typeof scDraft==='function')scDraft();if(typeof scAbort==='function')scAbort();if(typeof focusClose==='function')focusClose(false);
 $('viewMaths').style.display='none';$('viewScience').hidden=true;$('viewMap').hidden=true;$('viewRoom').style.display='none';$('viewCourse').hidden=true;$('focusDock').hidden=true;$('courseReturn').hidden=true;
 if(typeof SCI!=='undefined')SCI.view='maths';document.body.classList.remove('science-active','course-active');document.body.classList.add('entrance-active');host.hidden=false;
 $('subjectMaths').setAttribute('aria-pressed','true');$('subjectScience').setAttribute('aria-pressed','false');
 view={kind,unit:['lesson','practice'].includes(kind)?id:null,paper:['paper','results'].includes(kind)?id:null};message='';pointer=null;
 if(kind==='lesson'){if(data().draft&&!data().attempts.find(a=>a.id===data().draft.id)?.correct)E.help(data());E.visit(data(),id,E.lesson(data(),id).page);exampleForm=0;}
 if(kind==='practice'&&!data().draft)E.startPractice(data(),id);
 if(kind==='paper'&&!data().papers[id])E.startPaper(data(),id);
 document.body.classList.toggle('entrance-paper',kind==='paper');render();save(S);document.dispatchEvent(new Event('mochi:activity'));
 const skip=document.querySelector('.skip-link');if(skip){skip.href='#epTitle';skip.textContent='Skip to the learning activity';}
 $('epTitle')?.focus({preventScroll:true});
}
function nextRecommended(){const r=E.recommend(S);if(r.kind==='paper'){open('paper',r.paper);return;}if(r.kind==='resume'){open('practice',data().draft.unit);return;}if(r.kind==='mixed'){open('papers');return;}if(r.kind==='learn'){open('lesson',r.unit);return;}beginPractice(r.unit,r.kind==='recall'?'recall':undefined);}
function beginPractice(id,phase){
 const d=data();if(d.draft&&d.draft.unit!==id){const old=d.attempts.find(a=>a.id===d.draft.id);if(!old?.correct&&!confirm('A question and its working are saved. Start a different question instead? The recorded answers will remain, but this unsent draft will be replaced.')){open('practice',d.draft.unit);return;}E.finishPractice(d);}
 if(d.draft&&d.attempts.find(a=>a.id===d.draft.id)?.correct)E.finishPractice(d);
 E.startPractice(d,id,{phase});open('practice',id);
}
function header(title,kicker='YOUR MATHEMATICS PATH'){return `<div class="ep-heading"><div><p class="ep-kicker">${esc(kicker)}</p><h1 id="epTitle" tabindex="-1">${esc(title)}</h1></div><span class="ep-target">June 2027<br><small>Preparation goal</small></span></div>`;}
function render(){
 if(!host||paused)return;
 const nav=`<nav class="ep-nav" aria-label="Mathematics pathway"><button id="epHome" ${view.kind==='home'?'aria-current="page"':''}>My path</button><button id="epLessons" ${view.kind==='lessons'||view.kind==='lesson'?'aria-current="page"':''}>Lessons</button><button id="epPapers" ${view.kind==='papers'||view.kind==='paper'?'aria-current="page"':''}>Papers</button><button id="epFoundations">Foundation classroom</button></nav>`;
 let html='';if(view.kind==='home')html=home();else if(view.kind==='lessons')html=lessonList();else if(view.kind==='lesson')html=lessonView();else if(view.kind==='practice')html=practiceView();else if(view.kind==='papers')html=paperList();else if(view.kind==='paper')html=paperView();else if(view.kind==='results')html=resultsView();
 document.body.classList.toggle('entrance-paper',view.kind==='paper');host.innerHTML=nav+html;wireNavigation();wire();paintParent();
}
function home(){
 const d=data(),r=E.recommend(S),report=E.report(d),u=r.unit&&E.unit(r.unit),active=r.kind==='paper'?E.paperDefinitions.find(p=>p.id===r.paper)?.title:u?.title||'Mixed reasoning';
 return header('Learn deeply. Solve independently.')+`<p class="ep-lead">Build the methods behind unfamiliar entrance-style questions. Learn an idea, try it, explain it, and return to it later.</p><section class="ep-next"><p class="ep-kicker">NEXT STEP</p><h2>${esc(active)}</h2><p>${esc(r.reason)}</p><button id="epContinue" class="ep-primary">${r.kind==='learn'?'Explore this lesson':r.kind==='paper'?'Resume saved paper':r.kind==='resume'?'Resume my question':'Continue my path'}</button></section><div class="ep-evidence-strip"><span><strong>${report.units.filter(x=>x.taught).length}/24</strong> methods explored</span><span><strong>${report.units.filter(x=>x.transfer).length}</strong> methods with independent transfer practice</span><span><strong>${report.units.filter(x=>x.delayed).length}</strong> revisited after a week</span></div><section class="ep-two-col"><div class="ep-card"><h2>A starting point, not a judgement</h2><p>Two short six-question checks show what needs teaching. Unfamiliar questions are expected. Results do not estimate an admission chance.</p><button data-start-paper="baseline-a">${d.papers['baseline-a']?.submittedAt?'Review check A':d.papers['baseline-a']?'Resume check A':'Starting-point check A'}</button><button data-start-paper="baseline-b">${d.papers['baseline-b']?.submittedAt?'Review check B':d.papers['baseline-b']?'Resume check B':'Starting-point check B'}</button></div><div class="ep-card"><h2>Our target</h2><p>Work towards 85% on three reserved mixed papers, broad coverage and explanations reviewed by an adult. Confirm progress using external unseen work.</p><p class="ep-note">${report.qualifyingPapers}/3 internal paper targets recorded. This is a training goal, not a school cutoff or a readiness percentage.</p><button id="epOpenProgress">See the evidence</button></div></section><details class="ep-details"><summary>The route to June</summary><div class="ep-timeline">${E.D.stages.map(s=>`<div><strong>${esc(s.title)}</strong><small>Planning window through ${esc(s.until)}</small><p>${esc(s.detail)}</p></div>`).join('')}</div><p>Progress determines the pace. Earlier foundations and the September SPERS goal remain available; the new maths preparation goal is June.</p></details><p class="ep-scope">${esc(E.D.scope)}</p>`;
}
function lessonList(){const d=data();return header('Methods that travel with you.')+`<p class="ep-lead">Each lesson includes an explanation, worked examples and a concept check. Existing foundation work guides recommendations; it is not relabelled as entrance-test mastery.</p>${Object.entries(E.D.strands).map(([key,title])=>`<section class="ep-strand"><h2>${esc(title)}</h2><div class="ep-lesson-grid">${E.D.units.filter(u=>u.strand===key).map(u=>{const e=E.evidence(d,u.id);return `<button class="ep-lesson-card" data-lesson="${u.id}"><strong>${esc(u.title)}</strong><span>${esc(e.stage)}</span><small>${e.apply} independent application · ${e.transfer} transfer practice · ${e.delayed} delayed</small></button>`;}).join('')}</div></section>`).join('')}`;}
function lessonView(){
 const u=E.unit(view.unit),l=E.lesson(data(),u.id),titles=['Understand the idea','See the method working','Check the idea'];let body='';
 if(l.page===0)body=`<article class="ep-teaching">${u.ideas.map(p=>`<p>${esc(p)}</p>`).join('')}<aside><strong>What should transfer?</strong><p>${esc(u.why)}</p></aside></article>`;
 if(l.page===1){const q=E.B.make(u.id,exampleForm,104729+E.D.units.indexOf(u)*7919);data().seen[q.fingerprint]=data().seen[q.fingerprint]||Date.now();body=`<label class="ep-select-label" for="epExample">Worked example</label><select id="epExample"><option value="0" ${exampleForm===0?'selected':''}>Start with the relationship</option><option value="1" ${exampleForm===1?'selected':''}>Apply the method</option><option value="2" ${exampleForm===2?'selected':''}>Change the problem structure</option></select><article class="ep-question-sheet"><p class="ep-question-text">${esc(q.text)}</p>${F.diagram(q.figure,q.id+'-worked',true)}<ol class="ep-worked">${q.steps.map(s=>`<li>${esc(s)}</li>`).join('')}</ol><p><strong>Answer: ${esc(q.answerLabel)} ${esc(q.suffix||'')}</strong></p><p class="ep-note">This is teaching, not independent evidence. Another valid method is welcome.</p></article>`;}
 if(l.page===2){const c=u.check,correct=l.conceptChoice===c[2];body=`<div class="ep-concept"><p class="ep-question-text">${esc(c[0])}</p><div class="ep-choices">${c[1].map((x,i)=>`<button data-concept="${i}" aria-pressed="${l.conceptChoice===i}">${esc(x)}</button>`).join('')}</div><p class="ep-feedback" role="status">${l.conceptChoice<0?'Choose and explain the relationship in your own words.':correct?'That relationship is correct. '+esc(c[3]):'Revisit the relationship. '+esc(c[3])}</p></div>`;}
 return header(u.title,E.D.strands[u.strand])+`<div class="ep-lesson-tabs" role="group" aria-label="Lesson sections">${titles.map((t,i)=>`<button data-page="${i}" aria-pressed="${l.page===i}">${i+1}. ${t}</button>`).join('')}</div>${body}<div class="ep-actions"><button id="epLessonPrevious" ${l.page===0?'disabled':''}>Previous</button>${l.page<2?'<button id="epLessonNext" class="ep-primary">Next section</button>':`<button id="epCompleteLesson" class="ep-primary" ${l.visited.length<3||l.conceptChoice!==u.check[2]?'disabled':''}>Finish lesson & try guided practice</button>`}</div>${data().draft?'<button id="epResumeDraft">Resume my saved question</button>':''}<details class="ep-details"><summary>My lesson notes</summary><textarea id="epLessonNotes" maxlength="6000" rows="4" aria-label="Lesson notes">${esc(l.notes)}</textarea><p>Notes are saved. Reading and concept-check completion measure exposure, not mastery.</p></details><details class="ep-details"><summary>Prerequisites and benchmark mapping</summary><p>${u.prerequisites.length?'Builds on: '+u.prerequisites.map(id=>esc(E.unit(id).title)).join('; '):'An entry point into this strand.'}</p><p>Working benchmark pages: ${esc(u.benchmarkPages)}. Original teaching, not copied exercises or an official syllabus.</p><button data-foundation="${u.foundation}">Open related foundation lesson</button></details>`;
}
function editor(q,saved={},paper=false,disabled=false){strokes=E.ink(saved.strokes||[]);return `<div class="ep-answer-area"><label for="epAnswer">Your answer${q.suffix?' ('+esc(q.suffix)+')':''}</label>${q.choices?`<div class="ep-choices">${q.choices.map(x=>`<button data-answer="${esc(x)}" aria-pressed="${saved.answer===x}" ${disabled?'disabled':''}>${esc(x)}</button>`).join('')}</div>`:''}<input id="epAnswer" ${q.choices?'class="ep-choice-value"':''} aria-label="Your answer" value="${esc(saved.answer||'')}" type="text" inputmode="text" autocomplete="off" maxlength="180" ${disabled?'disabled':''}><p class="ep-note">Fractions such as 3/4 or 1 1/2 are accepted. Use π or pi for an exact circle expression.</p><div class="ep-input-switch" role="group" aria-label="Working input"><button id="epKeyboard" aria-pressed="${!pen}">Keyboard</button><button id="epStylus" aria-pressed="${pen}">Stylus</button></div><label for="epWorking">My reasoning and checks <small>(saved, not automatically graded)</small></label><textarea id="epWorking" rows="4" maxlength="6000" placeholder="Represent the relationship, show your steps, then check.">${esc(saved.working||'')}</textarea><div id="epInkArea" ${pen?'':'hidden'}><label class="ep-check"><input type="checkbox" id="epPenOnly" checked> Pen only; uncheck to draw with a finger</label><canvas id="epCanvas" width="800" height="320" aria-label="Saved handwriting pad"></canvas><button id="epUndoInk">Undo stroke</button><button id="epClearInk">Clear drawing</button></div>${!paper?`<label class="ep-check"><input type="checkbox" id="epGuess" ${saved.guess?'checked':''} ${disabled?'disabled':''}> I guessed or received help outside the app</label>`:''}</div>`;}
function practiceView(){
 const v=data().draft;if(!v){view={kind:'home'};return home();}view.unit=v.unit;const q=E.question(v),a=data().attempts.find(x=>x.id===v.id),u=E.unit(v.unit),done=!!a?.correct;
 const status=done?(a.independent&&!a.seenBefore?'Correct on the first answer without recorded help.':a.independent?'Correct familiar practice.':'Correct after support or revision.'):'',phase={guided:'Guided practice',apply:'Independent application',transfer:'Transfer practice',recall:'Delayed retrieval'}[v.phase];
 let feedback=message||status;if(a&&!a.correct&&!message)feedback=a.responses.length>=2?'Two attempts need a closer look. Revisit the lesson or open the worked solution, then try a fresh question.':'Not yet. Check your representation, calculation and units. You can revise.';
