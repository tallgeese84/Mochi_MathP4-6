  if(form===0){const n=r(5,13);out(`${n} players enter a tournament. Each pair plays exactly one match. How many matches are played?`,n*(n-1)/2,[`Each player has ${n-1} opponents.`,`${n} × ${n-1} counts every match twice, once for each player.`,`Matches = ${n} × ${n-1} ÷ 2 = ${n*(n-1)/2}.`],{n});}
  if(form===1){const cols=r(3,7),rows=r(2,5);out('How many rectangles, including squares, have their sides along the lines of the complete grid shown?',cols*(cols+1)*rows*(rows+1)/4,[`Choose two of the ${cols+1} vertical boundaries: ${cols*(cols+1)/2} choices.`,`Choose two of the ${rows+1} horizontal boundaries: ${rows*(rows+1)/2} choices.`,`Multiply: ${cols*(cols+1)*rows*(rows+1)/4} rectangles.`],{cols,rows},{figure:{kind:'grid',cols,rows,alt:`A complete rectangular grid with ${cols} columns and ${rows} rows; count all rectangles using its lines.`}});}
  if(form===2){const a=r(5,11),b=r(4,9);out(`A team must contain one pupil from a club of ${a} pupils and one from a different club of ${b} pupils. The clubs have no pupils in common. How many teams are possible?`,a*b,[`Each of the ${a} pupils in the first club can be paired with ${b} in the second.`,`These cases do not overlap because the clubs are distinct.`,`There are ${a*b} teams; do not divide by 2.`],{a,b});}
  if(form===3){const lines=r(7,15),parallel=r(2,4);out(`${lines} straight lines are drawn in a plane. Exactly ${parallel} of them are mutually parallel. No other pair is parallel, and no three lines meet at one point. What is the maximum number of regions formed?`,1+lines*(lines+1)/2-parallel*(parallel-1)/2,[`With no parallel lines or triple intersections, each added line creates one more region than the number of its intersections.`,`Total would be 1 + 1 + 2 + … + ${lines} = ${1+lines*(lines+1)/2}.`,`The parallel group removes ${parallel*(parallel-1)/2} pairwise intersections and hence that many regions.`,`Maximum = ${1+lines*(lines+1)/2-parallel*(parallel-1)/2}.`],{lines,parallel});}
 }else if(unit==='digits'){
  if(form===0){const a=r(5,9),b=r(1,a-1),sum=a+b,difference=9*(a-b);out(`A two-digit number has digit sum ${sum}. It is ${difference} greater than the number obtained by reversing its digits. Find the original number.`,10*a+b,[`Let the digits be a and b. Then a + b = ${sum}.`,`(10a+b) − (10b+a) = 9(a−b) = ${difference}.`,`So a − b = ${difference/9}. Solving gives a = ${a}, b = ${b}.`,`The number is ${10*a+b}.`],{sum,difference});}
  if(form===1){const digits=pick([3,4,5,6]),free=Math.ceil(digits/2);out(`How many ${digits}-digit positive integers are palindromes? A palindrome reads the same forwards and backwards.`,9*10**(free-1),[`Choose the first ${free} digits; the rest are determined by reflection.`,`The leading digit has 9 choices. Each other free digit has 10.`,`Count = 9 × 10^${free-1} = ${9*10**(free-1)}.`],{digits});}
  if(form===2){const divisor=pick([3,9]),lo=r(1,4),hi=r(6,9);let count=0;for(let a=lo;a<=hi;a++)for(let b=0;b<10;b++)if((101*a+10*b)%divisor===0)count++;out(`How many three-digit palindromes are divisible by ${divisor} and have a hundreds digit from ${lo} to ${hi}, inclusive?`,count,[`Write each palindrome as aba. Its digit sum is 2a + b.`,`For each a from ${lo} to ${hi}, list b = 0 to 9 satisfying divisibility by ${divisor}.`,`The cases are disjoint and give ${count} valid numbers.`],{divisor,lo,hi});}
  if(form===3){const limit=r(3,7);let count=0;for(let a=1;a<=limit;a++)for(let b=0;b<=limit;b++)for(let c=0;c<=limit;c++)if((2*a+2*b+c)%3===0)count++;out(`Only the digits 0 to ${limit} may be used, with repetition allowed. How many five-digit palindromes made from these digits are divisible by 3?`,count,[`Write the number as abcba, with a from 1 to ${limit}, and b,c from 0 to ${limit}.`,`Divisibility by 3 requires 2a + 2b + c to be divisible by 3.`,`For every pair (a,b), count the allowed c values. This complete case count is ${count}.`],{limit});}
 }else if(unit==='sums'){
  if(form===0){const first=r(12,45),last=first+r(30,80);out(`Find the sum of all integers from ${first} to ${last}, inclusive.`,(last-first+1)*(first+last)/2,[`There are ${last} − ${first} + 1 = ${last-first+1} terms.`,`Pair the first and last terms; the average term is (${first}+${last})/2.`,`Sum = ${last-first+1} × (${first}+${last}) ÷ 2 = ${(last-first+1)*(first+last)/2}.`],{first,last});}
  if(form===1){const last=2*r(30,100)+1;out(`Evaluate 1 − 2 + 3 − 4 + … − ${last-1} + ${last}.`,(last+1)/2,[`Pair (1−2), (3−4), and so on. There are ${(last-1)/2} pairs, each equal to −1.`,`The final term ${last} is unpaired.`,`Total = ${last} − ${(last-1)/2} = ${(last+1)/2}.`],{last});}
  if(form===2){const b=r(40,120),a=b+r(2,8);out(`Evaluate ${a}² − ${b}² without separately multiplying both squares.`,(a-b)*(a+b),['Use a² − b² = (a − b)(a + b).',`(${a} − ${b}) × (${a} + ${b}) = ${a-b} × ${a+b} = ${(a-b)*(a+b)}.`],{a,b});}
  if(form===3){const start=r(8,18),end=start+r(7,15),sum=n=>n*(n+1)*(2*n+1)/6;out(`Find ${start}² + ${start+1}² + … + ${end}².`,sum(end)-sum(start-1),['Use S(n) = 1² + … + n² = n(n+1)(2n+1)/6.',`Required sum = S(${end}) − S(${start-1}).`,`${sum(end)} − ${sum(start-1)} = ${sum(end)-sum(start-1)}.`],{start,end});}
 }else if(unit==='patterns'){
